# Copy to .env and replace the placeholders before starting Docker Compose.
ANTHROPIC_API_KEY=your_api_key
# Optional: Anthropic-compatible endpoint and model name
# ANTHROPIC_BASE_URL=https://your-provider.example/anthropic
# ANTHROPIC_MODEL=your_model_name

REDIS_PASSWORD=replace_with_a_strong_password
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
ECHOMIND_SKILLS_DIR=/app/skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000
EVAL_BASELINE_PATH=/app/data/eval/baseline.json
LOG_LEVEL=INFO
MONITOR_INTERVAL=10
PROMETHEUS_PORT=0
# ALERT_WEBHOOK_URL=
